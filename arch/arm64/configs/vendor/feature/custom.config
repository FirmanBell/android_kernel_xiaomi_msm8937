# Localversion
CONFIG_LOCALVERSION="-Loneliness"
# CONFIG_LOCALVERSION_AUTO is not set

# KSU
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KPROBES=n

# Tweak
CONFIG_CPUSETS_ASSIST=y

# Make sure Software DT2W is disabled, It's not allowed
CONFIG_TOUCHSCREEN_DOUBLETAP2WAKE=y
CONFIG_TOUCHSCREEN_SWEEP2WAKE=y

# CPU Idle
CONFIG_CPU_IDLE_GOV_TEO=y