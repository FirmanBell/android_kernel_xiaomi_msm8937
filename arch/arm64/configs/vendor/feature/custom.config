# Localversion
CONFIG_LOCALVERSION="-Loneliness"
# CONFIG_LOCALVERSION_AUTO is not set

# KSU
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KPROBES=n

# Tweak
CONFIG_CPUSETS_ASSIST=y

# I/O Scheduler 
CONFIG_IOSCHED_ANXIETY=y
CONFIG_IOSCHED_ZEN=y
CONFIG_DEFAULT_ANXIETY=y
CONFIG_DEFAULT_IOSCHED="anxiety"